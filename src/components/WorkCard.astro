---
/** 事例カード（事例紹介ページ・トップの抜粋カルーセルで共有） */
import type { WorkCase } from "../data/works";
interface Props { c: WorkCase; class?: string; }
const { c, class: cls = "" } = Astro.props;
---
<article class:list={["group", cls]}>
  <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-ink-100">
    <img src={c.img} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" loading="lazy" decoding="async" />
    <span class="absolute top-3 left-3 num text-[10px] tracking-[0.28em] text-white bg-ink-900/80 backdrop-blur px-2.5 py-1">CASE N°{c.no}</span>
  </div>
  <h3 class="mt-5 flex items-center gap-2 font-bold text-lg md:text-xl text-ink-900">
    {c.title}
    <span class="text-brand-500 transition-transform group-hover:translate-x-1" aria-hidden="true">›</span>
  </h3>
  <p class="mt-2 text-sm md:text-base text-ink-600">{c.tagline}</p>
  <p class="mt-5 text-xs font-bold tracking-wider text-brand-600">{c.category}</p>
  <div class="mt-2.5 flex flex-wrap gap-1.5">
    {c.tags.map((t) => (
      <span class="text-[11px] leading-none px-2.5 py-1.5 bg-ink-50 border border-ink-100 text-ink-600">{t}</span>
    ))}
  </div>
</article>
