---
import { getCollection } from "astro:content";

// 下部 Topics ティッカー用に最新ニュースを1件取得
const topics = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const topic = topics[0];
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---
<section class="relative isolate overflow-hidden bg-ink-900 text-white min-h-[100dvh] flex flex-col">
  <!--
    MV：全画面動画を背景に、左下へ大判ゴシックのキャッチを置く構成。
    動画 mp4 があれば自動でポスター画像から切替。無い環境では静止で成立。
  -->
  <video
    id="hero-video"
    class="absolute inset-0 -z-10 w-full h-full object-cover"
    poster="/img/hero-poster-1280.webp"
    autoplay muted loop playsinline preload="metadata"
    aria-hidden="true"
    hidden
  >
    <source src="/hero.mp4" type="video/mp4" />
  </video>

  <div id="hero-bg" class="absolute inset-0 -z-10">
    <img
      src="/img/hero-poster-1280.webp"
      srcset="/img/hero-poster-960.webp 960w, /img/hero-poster-1280.webp 1280w"
      sizes="100vw"
      alt=""
      class="w-full h-full object-cover"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <!-- 下重心のグラデ暗幕：左下のキャッチを読ませる -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-900/92 via-ink-900/55 to-ink-900/35"></div>
  <div id="hero-overlay" class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-900/88 via-ink-900/45 to-ink-900/25" hidden></div>

  <div class="wrap-wide relative flex-1 flex flex-col">
    <!-- Top rail：番号付き索引（Swiss index rail・薄く） -->
    <header class="pt-6 md:pt-8 flex items-center justify-between text-[10px] md:text-[11px] tracking-[0.28em] text-ink-100/70 font-bold uppercase">
      <span class="num">2026 — N°20</span>
      <span class="hidden sm:inline">Electrical Direction &amp; Maintenance</span>
      <span class="text-right num">Osaka × Tokyo</span>
    </header>

    <!-- 下寄せスペーサー -->
    <div class="flex-1"></div>

    <!-- Bottom-left：大判キャッチ -->
    <div class="pb-8 md:pb-10">
      <p class="text-[10px] md:text-xs tracking-[0.3em] text-warm-300 font-bold uppercase">Momoya System</p>

      <h1 class="mt-5 font-serif font-black text-[2.75rem] sm:text-6xl md:text-7xl lg:text-8xl leading-[0.98] tracking-[-0.03em]">
        電気工事の、<br />
        打ち合わせ屋<span class="text-warm-500">.</span>
      </h1>

      <!-- キャッチは活かしつつ、「位置合わせ屋」の点を記載 -->
      <p class="mt-7 text-base md:text-xl font-bold leading-[1.6] text-white max-w-[40ch]">
        元請と現場の“あいだ”に立ち、<span class="whitespace-nowrap">認識のズレを合わせる。</span><br class="hidden md:block" />
        電気工事の、<span class="border-b-2 border-warm-500 pb-0.5">位置合わせ屋</span>です。
      </p>
      <p class="mt-3 text-[11px] md:text-sm tracking-[0.32em] text-ink-100/70 font-bold uppercase">
        Momoya aligns every site.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/contact" data-track="cta_click:hero_primary" class="btn-warm">
          5分の現場ヒアリングを依頼する <span aria-hidden="true">→</span>
        </a>
        <a href="/service" data-track="cta_click:hero_secondary" class="btn-ghost text-white">
          事業内容（二軸）を見る
        </a>
      </div>
    </div>
  </div>

  <!-- Topics ティッカー（全幅・最下部） -->
  {topic && (
    <a
      href={`/news/${topic.id}`}
      class="relative z-10 border-t border-white/15 hover:bg-white/5 transition-colors"
    >
      <div class="wrap-wide flex items-center gap-4 md:gap-8 py-4 text-sm">
        <span class="text-[10px] md:text-xs tracking-[0.3em] text-warm-300 font-bold uppercase flex-shrink-0">Topics</span>
        <time class="num text-ink-100/70 flex-shrink-0" datetime={topic.data.date.toISOString()}>{fmt(topic.data.date)}</time>
        <span class="truncate text-ink-100/90 font-bold">{topic.data.title}</span>
        <span class="ml-auto flex-shrink-0 text-ink-100/60" aria-hidden="true">→</span>
      </div>
    </a>
  )}

  <script is:inline>
    // 動画背景は「あれば使う」。無い環境ではポスター画像のまま静止で成立させる。
    // 視差過敏（prefers-reduced-motion）と通信量節約（Save-Data）の指定時は再生しない。
    (() => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const saveData = navigator.connection && navigator.connection.saveData;
      if (reduced || saveData) return;

      fetch("/hero.mp4", { method: "HEAD" }).then((r) => {
        if (!r.ok) return;
        const v = document.getElementById("hero-video");
        const bg = document.getElementById("hero-bg");
        const ov = document.getElementById("hero-overlay");
        if (v) v.hidden = false;
        if (bg) bg.hidden = true;
        if (ov) ov.hidden = false;
      }).catch(() => {});
    })();
  </script>
</section>
