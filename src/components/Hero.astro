---
import { getCollection } from "astro:content";
import { site } from "../data/site";

// 下部 Topics ティッカー用に最新ニュースを1件取得
const topics = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const topic = topics[0];
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---
<section class="relative isolate overflow-hidden bg-ink-900 text-white min-h-[80dvh] flex flex-col">
  <!--
    MV：全画面動画を背景に、左下へ大判ゴシックのキャッチを置く構成。
    動画 mp4 があれば自動でポスター画像から切替。無い環境では静止で成立。
  -->
  <video
    id="hero-video"
    class="absolute inset-0 -z-10 w-full h-full object-cover"
    poster="/img/hero-poster-1280.webp"
    autoplay muted loop playsinline preload="metadata"
    aria-hidden="true"
    hidden
  >
    <source src="/hero.mp4" type="video/mp4" />
  </video>

  <div id="hero-bg" class="absolute inset-0 -z-10">
    <img
      src="/img/hero-poster-1280.webp"
      srcset="/img/hero-poster-960.webp 960w, /img/hero-poster-1280.webp 1280w"
      sizes="100vw"
      alt=""
      class="w-full h-full object-cover"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <!-- 暗幕はほぼ無し（明るく）。最下部のティッカー可読のため下端だけ僅かに -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-900/30 via-transparent to-transparent"></div>
  <div id="hero-overlay" class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-900/20 via-transparent to-transparent" hidden></div>

  <div class="wrap-wide relative flex-1 flex flex-col">
    <!-- 上下スペーサーでキャッチをやや上寄せ（下端に貼り付けない） -->
    <div class="flex-1"></div>

    <!-- Bottom-left：大判キャッチ（ファーストビュー ≈100dvh に収める） -->
    <div class="pb-6 md:pb-8">
      <p class="text-[10px] md:text-xs tracking-[0.3em] text-warm-300 font-bold uppercase">Momoya System</p>

      <h1 class="mt-4 font-serif font-black text-[2.5rem] sm:text-5xl md:text-6xl lg:text-7xl tracking-[-0.03em]" style="line-height:1.3;">
        <span class="hero-catch">電気工事の、<br />打ち合わせ屋.</span>
      </h1>

      <!-- キャッチは活かしつつ、位置づけを記載（青帯×白文字） -->
      <p class="mt-6 text-sm md:text-lg font-bold" style="line-height:2.0;">
        <span class="hero-catch-sub">「あいだ」に立ち、認識のズレを合わせる。</span><br />
        <span class="hero-catch-sub">電気工事のテクニカルディレクター。</span>
      </p>
      <p class="mt-4 text-[10px] md:text-xs tracking-[0.32em] text-ink-100/80 font-bold uppercase">
        Momoya aligns every site.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/contact?topic=reserve" data-track="cta_click:hero_primary" class="btn-warm">
          {site.labels.ctaReserve} <span aria-hidden="true">→</span>
        </a>
        <a href="/contact?topic=docs" data-track="cta_click:hero_secondary" class="btn-ghost text-white">
          {site.labels.ctaDocs}
        </a>
      </div>
    </div>

    <!-- 下スペーサー（キャッチを下端に貼り付けずやや上へ） -->
    <div class="flex-[0.5]"></div>
  </div>

  <!-- Topics ティッカー（全幅・最下部） -->
  {topic && (
    <a
      href={`/news/${topic.id}`}
      class="relative z-10 border-t border-white/15 hover:bg-white/5 transition-colors"
    >
      <div class="wrap-wide flex items-center gap-4 md:gap-8 py-4 text-sm">
        <span class="text-[10px] md:text-xs tracking-[0.3em] text-warm-300 font-bold uppercase flex-shrink-0">Topics</span>
        <time class="num text-ink-100/70 flex-shrink-0" datetime={topic.data.date.toISOString()}>{fmt(topic.data.date)}</time>
        <span class="truncate text-ink-100/90 font-bold">{topic.data.title}</span>
        <span class="ml-auto flex-shrink-0 text-ink-100/60" aria-hidden="true">→</span>
      </div>
    </a>
  )}

  <script is:inline>
    // 動画背景は「あれば使う」。無い環境ではポスター画像のまま静止で成立させる。
    // 視差過敏（prefers-reduced-motion）と通信量節約（Save-Data）の指定時は再生しない。
    (() => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const saveData = navigator.connection && navigator.connection.saveData;
      if (reduced || saveData) return;

      fetch("/hero.mp4", { method: "HEAD" }).then((r) => {
        if (!r.ok) return;
        const v = document.getElementById("hero-video");
        const bg = document.getElementById("hero-bg");
        const ov = document.getElementById("hero-overlay");
        if (v) v.hidden = false;
        if (bg) bg.hidden = true;
        if (ov) ov.hidden = false;
      }).catch(() => {});
    })();
  </script>
</section>
