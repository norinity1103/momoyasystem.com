---
import { site } from "../data/site";
---
<section class="relative isolate overflow-hidden bg-ink-900 text-white min-h-[100dvh] flex flex-col">
  <!--
    Swiss Poster Field:
    - 一枚の写真をオブジェクトとして配置（poster discipline）
    - 飾りグラデを最小化、グリッドは構造的に
    - 動画 mp4 があれば自動切替
  -->
  <video
    id="hero-video"
    class="absolute inset-0 -z-10 w-full h-full object-cover"
    poster="/img/scaffold-1920.jpg"
    autoplay muted loop playsinline preload="metadata"
    aria-hidden="true"
    hidden
  >
    <source src="/hero.mp4" type="video/mp4" />
  </video>

  <div id="hero-bg" class="absolute inset-0 -z-10">
    <img
      src="/img/scaffold-1920.jpg"
      srcset="/img/scaffold-960.jpg 960w, /img/scaffold-1920.jpg 1920w"
      sizes="100vw"
      alt=""
      class="w-full h-full object-cover"
      fetchpriority="high"
      decoding="async"
    />
    <!-- 単一の暗幕。装飾ノイズなし。 -->
    <div class="absolute inset-0 bg-ink-900/82"></div>
  </div>

  <div class="container-x relative flex-1 flex flex-col">
    <!-- Top rail: 番号付き索引（Swiss index rail） -->
    <header class="pt-6 md:pt-8 grid grid-cols-12 gap-x-6 text-[10px] md:text-[11px] tracking-[0.28em] text-ink-100/60 font-bold uppercase border-b border-white/15 pb-5">
      <div class="col-span-3 num">2026 — N°20</div>
      <div class="hidden md:block col-span-3">Direction Co.</div>
      <div class="col-span-5 md:col-span-3 text-right md:text-left">Osaka × Tokyo</div>
      <div class="hidden md:block col-span-3 text-right num">Vol. 001</div>
    </header>

    <!-- Poster Field: Display + Image plate（split asymmetric） -->
    <div class="grid grid-cols-12 gap-x-6 gap-y-12 mt-12 md:mt-20 lg:mt-24 flex-1 items-start">
      <!-- Display headline（8/12 col） -->
      <h1 class="col-span-12 md:col-span-9 font-serif font-black text-[3rem] sm:text-6xl md:text-[6.25rem] lg:text-[8rem] leading-[0.95] tracking-[-0.035em]">
        電気工事の、<br />
        打ち合わせ屋<span class="text-warm-500">.</span>
      </h1>

      <!-- Right rail: 縦書き風メタ -->
      <aside class="col-span-12 md:col-span-3 md:pl-6 md:border-l border-white/20">
        <p class="text-[10px] tracking-[0.3em] text-warm-300 font-bold uppercase">Position</p>
        <p class="mt-3 text-sm md:text-base leading-[1.8] text-ink-100/90">
          上流と下流の<br class="hidden md:inline" />「あいだ」に立つ、<br />
          現場経験20年の<br class="hidden md:inline" />実務番頭。
        </p>
      </aside>
    </div>

    <!-- Sub: 説明と数値スペックを bottom rail に flush -->
    <footer class="pb-10 md:pb-12 mt-auto">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10 pt-12 border-t border-white/15">
        <div class="col-span-12 md:col-span-6 lg:col-span-5">
          <p class="text-base md:text-lg leading-[1.85] text-ink-100/90 max-w-[55ch]">
            ゼネコン・設計・メーカーと施工現場の<strong class="text-white border-b border-warm-500 pb-0.5">「あいだ」</strong>に立ち、図面・打ち合わせ・工程・コストを翻訳します。
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/why" data-track="cta_click:hero_why" class="btn-warm">
              なぜ「あいだ」が必要か <span aria-hidden="true">→</span>
            </a>
            <a href="/contact" data-track="cta_click:hero_contact" class="btn-ghost text-white">
              見積・相談する
            </a>
          </div>
        </div>

        <!-- Tabular spec strip — Swiss style -->
        <dl class="col-span-12 md:col-span-6 lg:col-start-7 lg:col-span-6 grid grid-cols-3 gap-0 border-t-2 border-warm-500/70">
          {site.metrics.map((m, i) => (
            <div class:list={["py-5 px-1 md:px-3", i !== 0 && "border-l border-white/15"]}>
              <p class="text-[9px] md:text-[10px] tracking-[0.25em] text-warm-300 font-bold uppercase leading-tight">{m.label}</p>
              <p class="mt-3 num-display text-3xl md:text-5xl text-white">{m.num}<span class="text-sm md:text-base text-ink-100/60 ml-1">{m.unit}</span></p>
            </div>
          ))}
        </dl>
      </div>
    </footer>
  </div>

  <div id="hero-overlay" class="absolute inset-0 -z-10 bg-ink-900/72" hidden></div>

  <script is:inline>
    fetch("/hero.mp4", { method: "HEAD" }).then((r) => {
      if (!r.ok) return;
      const v = document.getElementById("hero-video");
      const bg = document.getElementById("hero-bg");
      const ov = document.getElementById("hero-overlay");
      if (v) v.hidden = false;
      if (bg) bg.hidden = true;
      if (ov) ov.hidden = false;
    }).catch(() => {});
  </script>
</section>
