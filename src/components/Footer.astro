---
import { site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="mt-32 bg-brand-900 text-ink-100">
  <div class="container-x py-16 grid md:grid-cols-3 gap-10">
    <div>
      <div class="flex items-center gap-3">
        <img src="/logo-mark.svg" alt="" width="40" height="40" class="block opacity-90" />
        <p class="font-serif text-xl font-bold">{site.name}</p>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-ink-300">{site.subTagline}</p>
      <p class="mt-6 text-xs text-ink-300">{site.legal.license}</p>
    </div>
    <div>
      <p class="text-xs tracking-[0.2em] text-brand-300">OFFICE</p>
      <dl class="mt-3 space-y-3 text-sm">
        <div><dt class="text-ink-300 text-xs">大阪本社</dt><dd>{site.contact.address.hq}</dd></div>
        <div><dt class="text-ink-300 text-xs">東京営業所</dt><dd>{site.contact.address.tokyo}</dd></div>
        <div><dt class="text-ink-300 text-xs">TEL / E-MAIL</dt><dd class="num">{site.contact.phone} / <a class="underline" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>
      </dl>
    </div>
    <div>
      <p class="text-xs tracking-[0.2em] text-brand-300">SITEMAP</p>
      <ul class="mt-3 space-y-2 text-sm">
        {site.nav.map((n) => <li><a href={n.href} class="hover:text-brand-300 transition">{n.label}</a></li>)}
        <li><a href="/news" class="hover:text-brand-300 transition">ニュース</a></li>
        <li><a href="/legal" class="hover:text-brand-300 transition">特定商取引法に基づく表記</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-brand-700">
    <div class="container-x py-5 text-xs text-ink-300 num">© {year} {site.name}. All rights reserved.</div>
  </div>
</footer>
