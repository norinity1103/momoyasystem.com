---
/**
 * 現場対応力パネル（Swiss System / Process Rail）
 * - 4等分カードではなく、横一本の process rail に再構築
 * - 接続線を visible に、duration を anchor に、step を checkpoint に
 * - tabular numerals、accent は warm-500 一点のみ
 */
import EditorialHeading from "./EditorialHeading.astro";
const steps = [
  { step: "01", label: "受付・一次連絡", duration: "24h",      hint: "営業日中は最短で当日中" },
  { step: "02", label: "現地調査・要件確認", duration: "1–3 day", hint: "上流の意図と現場制約を翻訳" },
  { step: "03", label: "見積・パートナー選定", duration: "3–7 day", hint: "50社+から最適チーム編成" },
  { step: "04", label: "着工・運用",     duration: "随時",    hint: "打合せ・図面・工程を一括管理" },
];

const credentials = [
  { k: "建設業許可",       v: "大阪府知事許可（電気工事業ほか）" },
  { k: "国家資格",         v: "1級電気施工管理技士 / 2級建築士" },
  { k: "パートナー網",      v: "全国 50 社以上の協力会社" },
  { k: "保険",            v: "請負業者賠償 ／ 生産物賠償（PL） ／ 労災総合" },
  { k: "対応エリア",       v: "全国（大阪本社 ・ 東京営業所）" },
  { k: "営業時間",         v: "平日 9:00 – 18:00（時間外応相談）" },
];
---
<section class="bg-white py-24 md:py-32 border-y border-ink-100 scroll-mt-24" id="flow">
  <div class="wrap-content">
    <!-- Section header — 共通あしらい（EditorialHeading） -->
    <EditorialHeading
      enBottom="Flow"
      jp="相談の流れ"
      intro="受けてから着工準備まで、標準3日。営業日中の一次連絡は24時間以内。現地調査・見積・パートナー手配を、最短で1週間以内に着工可能な状態まで進めます。"
    />

    <!-- Process rail（接続線あり） -->
    <div class="mt-16 md:mt-20 relative">
      <!-- 接続線：md以上で水平 -->
      <div class="hidden md:block absolute top-[1.4rem] left-0 right-0 h-px bg-ink-300/70" aria-hidden="true"></div>
      <ol class="grid grid-cols-1 md:grid-cols-4 gap-y-12 md:gap-y-0 md:gap-x-6">
        {steps.map((s) => (
          <li class="relative">
            <!-- Checkpoint dot -->
            <div class="flex items-center gap-3 md:block">
              <span class="block w-3 h-3 bg-warm-500 md:mb-3 relative z-10" aria-hidden="true"></span>
              <span class="num text-[10px] tracking-[0.28em] text-warm-700 font-bold md:hidden">STEP {s.step}</span>
            </div>
            <span class="hidden md:block num text-[10px] tracking-[0.28em] text-warm-700 font-bold">STEP {s.step}</span>
            <p class="mt-4 num-display text-3xl md:text-4xl text-ink-900">{s.duration}</p>
            <p class="mt-3 font-serif text-base md:text-lg font-bold text-ink-900 leading-snug">{s.label}</p>
            <p class="mt-2 text-xs text-ink-500 leading-relaxed md:max-w-[24ch]">{s.hint}</p>
          </li>
        ))}
      </ol>
    </div>

    <!-- Credentials — spec sheet（Swiss） -->
    <div class="mt-20 md:mt-28 grid grid-cols-12 gap-x-6 gap-y-8">
      <div class="col-span-12 md:col-span-4">
        <p class="swiss-eyebrow text-ink-700">Credentials</p>
        <h3 class="mt-5 font-serif text-lg md:text-xl lg:text-2xl font-bold leading-[1.15] tracking-tight">
          許可・資格・体制。
        </h3>
        <p class="mt-4 text-sm text-ink-700 leading-[1.85] max-w-[30ch]">
          設備工事会社としての基礎は、20年の積み重ねの中で揃えてきました。
          数字とラベルで、淡々と。
        </p>
      </div>
      <dl class="col-span-12 md:col-span-8 border-t-2 border-ink-900">
        {credentials.map((row) => (
          <div class="spec-row">
            <dt>{row.k}</dt>
            <dd>{row.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
