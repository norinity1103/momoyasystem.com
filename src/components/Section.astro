---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  tone?: "light" | "dark" | "tint";
  id?: string;
  /** 背景に細かいグリッドを敷く（lightトーン時のみ意味あり） */
  grid?: boolean;
}
const { eyebrow, title, lead, tone = "light", id, grid = false } = Astro.props;
const toneClass =
  tone === "dark" ? "bg-brand-900 text-white"
  : tone === "tint" ? "bg-ink-50 text-ink-900"
  : "bg-white text-ink-900";
const eyebrowColor = tone === "dark" ? "text-brand-300" : "text-brand-500";
const leadColor = tone === "dark" ? "text-ink-100" : "text-ink-700";
const accentLine = tone === "dark" ? "bg-brand-300" : "bg-brand-500";
---
<section id={id} class:list={["relative py-24 md:py-32 overflow-hidden", toneClass, grid && tone !== "dark" && "bg-grid"]}>
  <div class="wrap-content relative">
    {eyebrow && (
      <div class="flex items-center gap-3 observe">
        <span class:list={["block w-8 h-[2px]", accentLine]}></span>
        <p class:list={["text-[10px] md:text-xs tracking-[0.3em] font-bold", eyebrowColor]}>{eyebrow}</p>
      </div>
    )}
    <h2 class="mt-5 font-serif font-black text-3xl md:text-5xl leading-[1.15] tracking-tight observe max-w-[22ch]">{title}</h2>
    {lead && <p class:list={["mt-6 max-w-[60ch] text-base md:text-lg leading-[1.85] observe", leadColor]}>{lead}</p>}
    <div class="mt-12 observe"><slot /></div>
  </div>
</section>
