---
/**
 * 画面右下のフローティングCTA（相談を予約する）。
 * 写真＋テキスト＋× クローズ。閉じるとセッション内は再表示しない。
 */
---
<div id="floating-cta" class="fixed bottom-4 right-4 z-50 w-[300px] max-w-[calc(100vw-2rem)] hidden sm:block">
  <div class="relative">
    <a
      href="/contact?topic=reserve"
      data-track="cta_click:floating_reserve"
      class="flex items-stretch rounded-2xl overflow-hidden shadow-[0_16px_40px_-12px_rgba(8,20,55,.5)] text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warm-400"
      style="background-image: linear-gradient(135deg, #1e5ad9 0%, #123a9e 100%);"
    >
      <img src="/img/site/photo-05.webp" alt="" class="w-[92px] object-cover flex-shrink-0" loading="lazy" decoding="async" />
      <div class="py-4 pl-4 pr-9">
        <p class="text-[10px] tracking-[0.18em] text-white/70 font-bold">モモヤシステム</p>
        <p class="mt-1 text-lg font-black leading-tight">相談を予約する</p>
        <p class="mt-1.5 text-[10px] tracking-[0.16em] text-white/70 font-bold">RESERVE CONSULTATION</p>
      </div>
    </a>
    <button
      type="button"
      data-close-cta
      aria-label="バナーを閉じる"
      class="absolute top-2 right-2 w-7 h-7 grid place-items-center rounded-full bg-white text-ink-900 shadow-md hover:bg-ink-100 transition"
    >
      <span aria-hidden="true" class="text-base leading-none">×</span>
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const el = document.getElementById("floating-cta");
    if (!el) return;
    if (sessionStorage.getItem("floatingCtaClosed") === "1") { el.remove(); return; }
    const btn = el.querySelector("[data-close-cta]");
    if (btn) {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        sessionStorage.setItem("floatingCtaClosed", "1");
        el.remove();
      });
    }
  })();
</script>
