---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** 任意：背景画像URL */
  bg?: string;
}
const { eyebrow, title, lead, bg } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-brand-900 text-white py-24 md:py-32">
  {bg && (
    <>
      <img src={bg} alt="" class="absolute inset-0 -z-10 w-full h-full object-cover opacity-40" loading="eager" decoding="async" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-900/95 via-brand-900/85 to-ink-900/95"></div>
    </>
  )}
  {!bg && (
    <div class="absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-brand-700 to-ink-900"></div>
      <div class="absolute inset-0 opacity-20 mix-blend-screen"
           style="background-image: radial-gradient(900px 450px at 75% 25%, #6c97cc 0%, transparent 65%), radial-gradient(700px 350px at 15% 85%, #d97706 0%, transparent 70%);"></div>
    </div>
  )}
  <!-- 装飾：グリッド -->
  <div class="absolute inset-0 -z-10 opacity-10"
       style="background-image: linear-gradient(transparent 0, rgba(255,255,255,.10) 1px, transparent 2px), linear-gradient(90deg, transparent 0, rgba(255,255,255,.08) 1px, transparent 2px); background-size: 48px 48px;"></div>
  <!-- 下端のフェード -->
  <div class="absolute inset-x-0 bottom-0 h-24 -z-10 bg-gradient-to-b from-transparent to-brand-900/60"></div>

  <div class="container-x relative">
    <div class="flex items-center gap-3 reveal">
      <span class="block w-10 h-[2px] bg-brand-300"></span>
      <p class="text-[10px] md:text-xs tracking-[0.3em] font-bold text-brand-300">{eyebrow}</p>
    </div>
    <h1 class="mt-6 font-serif text-4xl md:text-6xl font-black leading-[1.1] tracking-tight reveal" set:html={title}></h1>
    {lead && <p class="mt-8 max-w-3xl text-base md:text-lg text-ink-100 leading-relaxed reveal" set:html={lead}></p>}
  </div>
</section>
