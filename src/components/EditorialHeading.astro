---
/**
 * 編集的見出し（共通あしらい）：大判の2段英字 ＋ 和文サブ ＋ 右側リード。
 * 事例紹介「Our / Works」、事業内容「Direction & / Maintenance」等で共有。
 */
interface Props {
  enTop: string;
  enBottom: string;
  jp: string;
  intro?: string;
  topColor?: string;    // 上段英字の色クラス
  bottomColor?: string; // 下段英字の色クラス
  size?: "md" | "lg";
}
const {
  enTop, enBottom, jp, intro,
  topColor = "text-ink-300",
  bottomColor = "text-brand-600",
  size = "lg",
} = Astro.props;
const enSize = size === "lg"
  ? "text-4xl sm:text-5xl md:text-6xl lg:text-7xl"
  : "text-3xl sm:text-4xl md:text-5xl";
---
<div class="grid grid-cols-12 gap-x-6 gap-y-8 items-end">
  <div class="col-span-12 md:col-span-7">
    <p class="font-serif font-black leading-[0.92] tracking-[-0.03em]">
      <span class:list={["block", enSize, topColor]}>{enTop}</span>
      <span class:list={["block", enSize, bottomColor]}>{enBottom}</span>
    </p>
    <p class="mt-6 text-lg md:text-xl font-bold text-ink-900">{jp}</p>
  </div>
  {intro && (
    <p class="col-span-12 md:col-span-4 md:col-start-9 text-sm md:text-base text-ink-700 leading-[1.9] max-w-[42ch]">{intro}</p>
  )}
</div>
