---
import { site } from "../data/site";
const { pathname } = Astro.url;
---
<header class="sticky top-0 z-40 bg-white/92 backdrop-blur border-b border-ink-100">
  <div class="container-x flex items-center justify-between h-16 md:h-20">
    <a href="/" class="flex items-center gap-3 group" aria-label="モモヤシステム ホームへ">
      <img src="/logo-mark.svg" alt="" width="36" height="36" class="block" />
      <span class="flex flex-col leading-tight">
        <span class="font-serif text-base md:text-lg font-black tracking-tight text-ink-900 group-hover:text-warm-700 transition">モモヤシステム</span>
        <span class="hidden md:inline text-[9px] tracking-[0.3em] text-ink-500 font-bold mt-0.5">MOMOYA SYSTEM</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-6 text-sm">
      {site.nav.slice(0, -1).map((item) => (
        <a
          href={item.href}
          class:list={[
            "relative transition pb-1 hover:text-warm-700",
            pathname.startsWith(item.href) ? "text-ink-900 font-bold" : "text-ink-700",
          ]}
        >
          {item.label}
          {pathname.startsWith(item.href) && (
            <span class="absolute -bottom-0.5 left-0 right-0 h-[2px] bg-warm-500"></span>
          )}
        </a>
      ))}
      <a href="/contact" class="ml-3 inline-flex items-center gap-2 px-5 py-2.5 bg-warm-500 text-white text-xs font-bold tracking-wider hover:bg-warm-600 transition">
        お問い合わせ <span aria-hidden="true">→</span>
      </a>
    </nav>

    <!-- Mobile menu toggle -->
    <button id="nav-toggle" class="lg:hidden flex flex-col gap-1.5 p-2 -mr-2" aria-label="メニュー" aria-expanded="false" aria-controls="mobile-nav">
      <span class="block w-6 h-[2px] bg-ink-900 transition-transform"></span>
      <span class="block w-6 h-[2px] bg-ink-900"></span>
      <span class="block w-6 h-[2px] bg-ink-900"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-nav" class="lg:hidden border-t border-ink-100 bg-white hidden" aria-label="モバイルメニュー">
    <ul class="container-x py-4 divide-y divide-ink-100">
      {site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "flex items-center justify-between py-4 text-base transition",
              pathname.startsWith(item.href) ? "text-warm-700 font-bold" : "text-ink-900",
            ]}
          >
            <span>{item.label}</span>
            <span class="text-ink-500" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <script is:inline>
    (() => {
      const btn = document.getElementById("nav-toggle");
      const menu = document.getElementById("mobile-nav");
      if (!btn || !menu) return;
      btn.addEventListener("click", () => {
        const isOpen = !menu.classList.contains("hidden");
        if (isOpen) { menu.classList.add("hidden"); btn.setAttribute("aria-expanded", "false"); }
        else { menu.classList.remove("hidden"); btn.setAttribute("aria-expanded", "true"); }
      });
    })();
  </script>
</header>
