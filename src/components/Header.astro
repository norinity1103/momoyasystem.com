---
import { site } from "../data/site";
const { pathname } = Astro.url;
---
<header class="sticky top-0 z-40 bg-white/85 backdrop-blur border-b border-ink-100">
  <div class="container-x flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2 group" aria-label="モモヤシステム ホームへ">
      <img src="/logo-mark.svg" alt="" width="32" height="32" class="block" />
      <span class="font-serif text-lg font-bold tracking-wider text-brand-700 group-hover:text-brand-500 transition">モモヤシステム</span>
      <span class="hidden md:inline text-[10px] tracking-[0.2em] text-ink-500 ml-2">MOMOYA SYSTEM</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-sm">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "transition hover:text-brand-500",
            pathname === item.href ? "text-brand-700 font-bold" : "text-ink-700",
          ]}
        >{item.label}</a>
      ))}
    </nav>
    <a href="/contact" class="md:hidden text-sm font-bold text-brand-700">お問い合わせ →</a>
  </div>
</header>
