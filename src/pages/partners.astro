---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

const trades = [
  { ix: "01", name: "電気工事業",          desc: "強電・弱電・通信・高圧まで" },
  { ix: "02", name: "内装・軽天・クロス",   desc: "店舗・オフィス・住宅の内装一式" },
  { ix: "03", name: "空調・換気設備",      desc: "業務用エアコン・換気・ダクト" },
  { ix: "04", name: "電気設計／CAD",      desc: "電気設計図・施工図・申請図" },
  { ix: "05", name: "土木・付帯",          desc: "充電器設置の基礎・配管・舗装" },
  { ix: "06", name: "その他関連工事",      desc: "メンテナンス・小規模リフォーム" },
];

const conditions = [
  { k: "支払サイト",     v: "月末締 ／ 翌月末払い（応相談）" },
  { k: "支払方法",       v: "銀行振込" },
  { k: "対応エリア",     v: "全国（案件発生地ベースで応相談）" },
  { k: "発注ロット",     v: "数万円〜数千万円規模まで案件規模を選びません" },
  { k: "図面・打合せ",   v: "原則モモヤが翻訳・調整。施工に集中いただけます" },
  { k: "材料",          v: "モモヤ手配または各社手配（応相談・支給対応可）" },
  { k: "保険",          v: "労災・賠償等の必要保険にご加入の事業者様" },
];

const flow = [
  { n: "01", t: "エントリー", d: "下記フォームから事業所情報をお送りください。1〜3営業日でご返信します。" },
  { n: "02", t: "面談・現場視察", d: "お互いの体制・得意領域・条件を確認。可能であれば現場ご一緒も。" },
  { n: "03", t: "条件合意",   d: "請負基本契約を締結のうえ、案件のマッチング開始。" },
  { n: "04", t: "案件マッチング", d: "規模・地域・時期に応じて継続的に案件をご紹介します。" },
];
---
<BaseLayout
  title="協力会社募集"
  description="モモヤシステムでは、電気工事・内装・空調・設計・土工など、現場を一緒に回せる協力会社様を募集しています。支払サイト 月末締・翌月末払い、全国エリア対応。"
  breadcrumbs={[{ name: "ホーム", href: "/" }, { name: "協力会社募集", href: "/partners" }]}
>
  <PageHero
    eyebrow="PARTNERS"
    title="協力会社募集"
    lead={`一緒に現場を回せる、施工パートナー様を募集しています。<br />図面・打合せ・工程・材料はモモヤが翻訳・調整するので、施工に集中いただける環境です。`}
    bg="/img/hero/partner.png"
    bgMobile="/img/hero/partner-960.png"
    bgKind="pattern"
  />

  <!-- N°01 — Editorial intro（asymmetric warm） -->
  <section class="bg-warm-50 py-24 md:py-32 relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 opacity-50"
         style="background-image: linear-gradient(rgba(124,66,32,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(124,66,32,.05) 1px, transparent 1px); background-size: 48px 48px;"></div>

    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 gap-y-12 items-start">
        <div class="col-span-12 md:col-span-5">
          <p class="swiss-eyebrow text-warm-700">N°01 / Letter</p>
          <h2 class="mt-5 font-serif font-black text-3xl md:text-5xl leading-[1.05] tracking-[-0.025em] text-warm-900">
            現場で動ける方を、<br />
            長くお付き合いしたい。
          </h2>
        </div>
        <div class="col-span-12 md:col-span-6 md:col-start-7">
          <p class="text-base md:text-lg text-ink-700 leading-[1.95] max-w-[44ch]">
            モモヤシステムは20期目に経営方針を「管理・ディレクション」へ転換しました。
            上流（ゼネコン・設計会社・メーカー）からいただく案件を、最適なチームに分配・調整するのが私たちの役目です。
          </p>
          <p class="mt-6 text-base md:text-lg text-ink-700 leading-[1.95] max-w-[44ch]">
            <strong class="text-warm-700">現場で力を発揮できる事業者様</strong>と、
            <strong>支払サイト・打合せ・図面・工程の負担を減らしながら</strong>、長く一緒に成長していきたいと思っています。
          </p>
          <p class="mt-8 num text-xs tracking-[0.25em] text-warm-700 font-bold">— 株式会社モモヤシステム 代表取締役 百々 彰彦</p>
        </div>
      </div>
    </div>
  </section>

  <!-- N°02 — Trades index（編集者的リスト、6カードではない） -->
  <section class="bg-white py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 items-end pb-5 border-b-2 border-ink-900">
        <div class="col-span-12 md:col-span-7">
          <p class="swiss-eyebrow text-ink-700">N°02 / Trades</p>
          <h2 class="mt-5 font-serif font-black text-3xl md:text-5xl leading-[1.05] tracking-[-0.02em]">
            募集している業種。
          </h2>
        </div>
        <p class="col-span-12 md:col-span-4 md:col-start-9 text-sm text-ink-700 leading-[1.85] max-w-[32ch]">
          以下に当てはまらなくても、現場のニーズに合えばお声がけください。
        </p>
      </div>

      <!-- Trades as typographic index -->
      <ol class="mt-12 max-w-4xl">
        {trades.map((t, i) => (
          <li class:list={["grid grid-cols-12 gap-x-6 py-5 md:py-6 items-baseline group hover:bg-warm-50/60 transition-colors -mx-6 px-6", i !== 0 && "border-t border-ink-100"]}>
            <span class="col-span-2 num text-sm md:text-base text-warm-700 font-bold tracking-wider">{t.ix}</span>
            <h3 class="col-span-12 md:col-span-5 -mt-1 md:mt-0 font-serif text-xl md:text-3xl font-bold leading-tight tracking-tight text-ink-900 group-hover:text-warm-700 transition">{t.name}</h3>
            <p class="col-span-12 md:col-span-5 text-sm md:text-base text-ink-500 leading-relaxed">{t.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- N°03 — Conditions（warm split, payment terms hero） -->
  <section class="bg-warm-100/60 py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 gap-y-12 items-start">
        <!-- Headline + payment hero callout -->
        <div class="col-span-12 md:col-span-5">
          <p class="swiss-eyebrow text-warm-700">N°03 / Terms</p>
          <h2 class="mt-5 font-serif font-black text-3xl md:text-5xl leading-[1.05] tracking-[-0.02em] text-warm-900">
            支払はきちんと、<br />
            条件は誠実に。
          </h2>

          <!-- Payment terms as a poster block, not a card -->
          <div class="mt-12 border-t-2 border-b-2 border-warm-700 py-8">
            <p class="text-[10px] tracking-[0.3em] text-warm-700 font-bold uppercase">Payment</p>
            <p class="mt-4 num-display text-4xl md:text-5xl text-warm-900 leading-[1.05]">月末締<br />翌月末払い</p>
            <p class="mt-4 text-sm text-ink-700 leading-relaxed max-w-[28ch]">建設業界の慣行から、お互いが続けやすい関係を意識しています。応相談OK。</p>
          </div>
        </div>

        <!-- Other terms as spec sheet -->
        <dl class="col-span-12 md:col-span-6 md:col-start-7 border-t-2 border-ink-900">
          {conditions.map((row) => (
            <div class="spec-row">
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- N°04 — Flow（process rail with connecting line） -->
  <section class="bg-white py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 items-end pb-5 border-b-2 border-ink-900">
        <div class="col-span-12 md:col-span-7">
          <p class="swiss-eyebrow text-ink-700">N°04 / Flow</p>
          <h2 class="mt-5 font-serif font-black text-3xl md:text-5xl leading-[1.05] tracking-[-0.02em]">取引開始までの流れ。</h2>
        </div>
      </div>
      <div class="mt-16 relative">
        <div class="hidden md:block absolute top-[1.25rem] left-0 right-0 h-px bg-ink-300/70" aria-hidden="true"></div>
        <ol class="grid grid-cols-1 md:grid-cols-4 gap-y-12 md:gap-y-0 md:gap-x-6">
          {flow.map((f) => (
            <li>
              <div class="flex items-center gap-3 md:block">
                <span class="block w-3 h-3 bg-warm-500 md:mb-3 relative z-10" aria-hidden="true"></span>
                <span class="num text-[10px] tracking-[0.28em] text-warm-700 font-bold md:hidden">STEP {f.n}</span>
              </div>
              <span class="hidden md:block num text-[10px] tracking-[0.28em] text-warm-700 font-bold">STEP {f.n}</span>
              <p class="mt-4 font-serif text-xl md:text-2xl font-bold text-ink-900 leading-snug">{f.t}</p>
              <p class="mt-3 text-sm text-ink-500 leading-relaxed max-w-[24ch]">{f.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- N°05 — Entry form（warm, focused） -->
  <section id="form" class="bg-warm-50 py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 gap-y-12 items-start">
        <div class="col-span-12 md:col-span-4">
          <p class="swiss-eyebrow text-warm-700">N°05 / Entry</p>
          <h2 class="mt-5 font-serif font-black text-3xl md:text-5xl leading-[1.05] tracking-[-0.02em] text-warm-900">
            まずは事業所情報を<br />
            お送りください。
          </h2>
          <p class="mt-6 text-sm text-ink-700 leading-[1.85] max-w-[30ch]">
            1〜3営業日以内に担当よりご返信します。<br />
            お電話でも歓迎です：<a class="num text-warm-700 underline" href="tel:0643927136">06-4392-7136</a>
          </p>
        </div>

        <form
          action="/api/contact"
          method="POST"
          class="col-span-12 md:col-span-8 space-y-7 bg-white p-7 md:p-12 border border-warm-100"
        >
          <input type="hidden" name="form-name" value="partners" />
          <input type="hidden" name="topic" value="協力会社エントリー" />
          <p class="hidden"><label>Bot field <input name="_gotcha" /></label></p>

          <div>
            <label class="text-[10px] tracking-[0.28em] text-warm-700 font-bold uppercase" for="company">会社名 <span class="text-warm-500">*</span></label>
            <input id="company" name="company" required class="mt-2 w-full border-b-2 border-ink-300 px-1 py-3 focus:border-warm-500 focus:outline-none bg-transparent" />
          </div>
          <div class="grid md:grid-cols-2 gap-x-6 gap-y-7">
            <div>
              <label class="text-[10px] tracking-[0.28em] text-warm-700 font-bold uppercase" for="name">ご担当者名 <span class="text-warm-500">*</span></label>
              <input id="name" name="name" required class="mt-2 w-full border-b-2 border-ink-300 px-1 py-3 focus:border-warm-500 focus:outline-none bg-transparent" />
            </div>
            <div>
              <label class="text-[10px] tracking-[0.28em] text-warm-700 font-bold uppercase" for="email">メールアドレス <span class="text-warm-500">*</span></label>
              <input id="email" name="email" type="email" required class="mt-2 w-full border-b-2 border-ink-300 px-1 py-3 focus:border-warm-500 focus:outline-none bg-transparent" />
            </div>
            <div>
              <label class="text-[10px] tracking-[0.28em] text-warm-700 font-bold uppercase" for="phone">電話番号</label>
              <input id="phone" name="phone" class="mt-2 w-full border-b-2 border-ink-300 px-1 py-3 focus:border-warm-500 focus:outline-none bg-transparent" />
            </div>
            <div>
              <label class="text-[10px] tracking-[0.28em] text-warm-700 font-bold uppercase" for="region">対応エリア</label>
              <select id="region" name="region" class="mt-2 w-full border-b-2 border-ink-300 px-1 py-3 focus:border-warm-500 focus:outline-none bg-transparent">
                <option>関東</option>
                <option>関西</option>
                <option>中部</option>
                <option>その他</option>
                <option>全国対応可</option>
              </select>
            </div>
          </div>
          <div>
            <label class="text-[10px] tracking-[0.28em] text-warm-700 font-bold uppercase" for="trade">主な業種 <span class="text-warm-500">*</span></label>
            <select id="trade" name="trade" required class="mt-2 w-full border-b-2 border-ink-300 px-1 py-3 focus:border-warm-500 focus:outline-none bg-transparent">
              <option>電気工事業</option>
              <option>内装・軽天・クロス</option>
              <option>空調・換気</option>
              <option>電気設計／CAD</option>
              <option>土木・付帯</option>
              <option>その他</option>
            </select>
          </div>
          <div>
            <label class="text-[10px] tracking-[0.28em] text-warm-700 font-bold uppercase" for="message">事業内容・得意領域・実績 <span class="text-warm-500">*</span></label>
            <textarea id="message" name="message" rows="6" required class="mt-2 w-full border border-ink-300 px-3 py-3 focus:border-warm-500 focus:outline-none bg-transparent leading-relaxed"></textarea>
          </div>
          <button type="submit" class="btn-warm">
            エントリーする <span aria-hidden="true">→</span>
          </button>
          <p class="text-xs text-ink-500">送信いただいた内容は、ご返信およびお取引検討以外には利用しません。</p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
