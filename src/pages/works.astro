---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import PageHero from "../components/PageHero.astro";

const cases = [
  {
    no: "001",
    year: "2024–2025",
    tag: "EV/PHV インフラ",
    sector: "急速充電器",
    scale: "複数拠点・全国",
    title: "急速充電器設置工事（複数案件）",
    summary: "全国展開する急速充電インフラの設計・施工・管理に対応。設置場所の電源計画から、申請、施工パートナー選定、現場打合せまでを一括ディレクション。",
    role: "設計補助／施工管理／パートナー選定／材料調達",
    img: "/img/scaffold-960.jpg",
  },
  {
    no: "002",
    year: "2023",
    tag: "公共・行政",
    sector: "視察対象案件",
    scale: "東京 / 中規模",
    title: "都知事による視察対象案件",
    summary: "東京都内の電気・付帯工事案件において、行政関係者の視察対象となる規模・品質で施工。ゼネコン・設計会社との上流での折衝にモモヤが介在。",
    role: "上流折衝／工程管理／品質管理",
    img: "/img/cityscape-1280.jpg",
  },
  {
    no: "003",
    year: "継続",
    tag: "メーカー直",
    sector: "電気機器メーカー",
    scale: "中〜大規模",
    title: "電気メーカーからの直接受注",
    summary: "電気機器メーカーとの長年の取引により、製造側の事情を理解した提案・施工が可能。図面作成・現場調整・パートナー手配を一貫で対応。",
    role: "図面作成／施工管理／材料調達",
    img: "/img/scaffold-1920.jpg",
  },
];

const stats = [
  { num: "20", unit: "年", label: "現場の実績" },
  { num: "50", unit: "社+", label: "パートナー網" },
  { num: "2", unit: "拠点", label: "東京・大阪" },
  { num: "100", unit: "%", label: "守秘義務遵守" },
];
---
<BaseLayout
  title="実績"
  description="モモヤシステムの実績紹介。EV/PHV急速充電器、都知事視察対象案件、電気メーカー直受注など、20年で積み上げた電気工事ディレクションの代表的なケース。"
  breadcrumbs={[{ name: "ホーム", href: "/" }, { name: "実績", href: "/works" }]}
>
  <PageHero
    eyebrow="WORKS"
    title="実績"
    lead="20年で積み上げた電気工事の現場経験は、いまディレクション側に立つことの説得力に変わりました。"
    bg="/img/scaffold-1920.jpg"
  />

  <!-- Swiss スタッツバー -->
  <section class="bg-white py-12 md:py-16 border-b border-ink-100">
    <div class="container-x">
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-0 border-t-2 border-ink-900">
        {stats.map((s, i) => (
          <div class:list={["p-6 md:p-8 border-b border-ink-100", i !== 0 && "md:border-l border-ink-100"]}>
            <dt class="text-[10px] tracking-[0.25em] text-warm-700 font-bold uppercase">{s.label}</dt>
            <dd class="mt-3 num-display text-4xl md:text-5xl text-ink-900">{s.num}<span class="text-base text-ink-500 ml-1">{s.unit}</span></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- データテーブル：Swiss プロジェクトリスト -->
  <section class="bg-white py-24 md:py-32">
    <div class="container-x">
      <div class="numbered-rule">
        <span class="num-mark">N°01</span>
        <span class="num-mark text-brand-700">／ プロジェクト一覧</span>
      </div>

      <!-- 横スクロール対応のデータテーブル -->
      <div class="mt-12 overflow-x-auto">
        <table class="w-full text-left min-w-[720px]">
          <thead>
            <tr class="border-t-2 border-b border-ink-900 text-[10px] tracking-[0.25em] text-ink-500 font-bold uppercase">
              <th class="py-4 pr-4 num w-16">N°</th>
              <th class="py-4 pr-4 num w-24">年</th>
              <th class="py-4 pr-4 w-32">分野</th>
              <th class="py-4 pr-4 w-32">業種</th>
              <th class="py-4 pr-4 w-32">規模</th>
              <th class="py-4 pr-4">担当領域</th>
            </tr>
          </thead>
          <tbody>
            {cases.map((c) => (
              <tr class="border-b border-ink-100 hover:bg-warm-50 transition-colors">
                <td class="py-5 pr-4 num text-sm text-warm-700 font-bold">{c.no}</td>
                <td class="py-5 pr-4 num text-sm text-ink-700">{c.year}</td>
                <td class="py-5 pr-4 text-sm text-ink-900 font-bold">{c.tag}</td>
                <td class="py-5 pr-4 text-sm text-ink-700">{c.sector}</td>
                <td class="py-5 pr-4 text-sm text-ink-700">{c.scale}</td>
                <td class="py-5 pr-4 text-xs text-ink-500 leading-relaxed">{c.role}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ケースカード（ビジュアル詳細） -->
  <section class="bg-warm-50 py-24 md:py-32">
    <div class="container-x">
      <div class="numbered-rule" style="border-color: var(--color-warm-700);">
        <span class="num-mark text-warm-700">N°02</span>
        <span class="num-mark text-warm-700">／ 代表的なケース</span>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12 observe-stagger">
        {cases.map((c) => (
          <article class="group bg-white border border-ink-100 hover:border-warm-500 hover:-translate-y-1 hover:shadow-[0_18px_40px_-16px_rgba(201,123,62,.3)] transition-all duration-300 flex flex-col overflow-hidden">
            <div class="relative aspect-[16/10] overflow-hidden bg-ink-100">
              <img src={c.img} alt="" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 via-transparent to-transparent"></div>
              <span class="absolute top-3 left-3 text-[10px] tracking-[0.2em] text-white bg-ink-900/80 backdrop-blur px-2 py-1 uppercase">{c.tag}</span>
              <span class="absolute top-3 right-3 num text-[10px] tracking-[0.25em] text-white bg-warm-600/90 px-2 py-1">N°{c.no}</span>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <p class="num text-[10px] tracking-[0.25em] text-warm-700 font-bold">{c.year}</p>
              <h3 class="mt-2 font-serif text-lg font-bold leading-snug text-ink-900 group-hover:text-warm-700 transition">{c.title}</h3>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed flex-1">{c.summary}</p>
              <p class="mt-4 pt-4 border-t border-ink-100 text-xs text-ink-500"><span class="text-warm-700 font-bold">担当領域：</span>{c.role}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-12 text-sm text-ink-500">※ 守秘義務の都合上、お客様名・所在地は抽象化して掲載しています。詳細はお問い合わせください。</p>
    </div>
  </section>

  <!-- WHY US -->
  <section class="bg-white py-24 md:py-32">
    <div class="container-x">
      <div class="numbered-rule">
        <span class="num-mark">N°03</span>
        <span class="num-mark text-brand-700">／ 選ばれる理由</span>
      </div>
      <ul class="mt-12 grid md:grid-cols-2 gap-0 border-t-2 border-ink-900 observe-stagger">
        {[
          "20年で蓄積した、案件規模に応じた業者選定眼。",
          "電気メーカーとの直取引で、材料原価とリードタイムを最適化。",
          "1級電気施工管理技士保有。設計・管理側からの視点で品質を担保。",
          "東京・大阪二拠点で、全国の案件に対応可能。",
        ].map((s, i) => (
          <li class:list={["p-7 border-b border-ink-100 text-base text-ink-700 leading-relaxed", i % 2 === 1 && "md:border-l border-ink-100"]}>{s}</li>
        ))}
      </ul>
    </div>
  </section>

  <Section tone="dark" eyebrow="NEXT" title="案件のご相談はこちら">
    <a href="/contact" class="btn-warm">
      お問い合わせフォームへ <span aria-hidden="true">→</span>
    </a>
  </Section>
</BaseLayout>
