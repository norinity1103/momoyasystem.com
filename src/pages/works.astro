---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import WorksShowcase from "../components/WorksShowcase.astro";

const stats = [
  { num: "20", unit: "年", label: "現場実績" },
  { num: "50", unit: "社+", label: "パートナー網" },
  { num: "2", unit: "拠点", label: "東京・大阪" },
];
---
<BaseLayout
  title="事例紹介"
  description="モモヤシステムの事例紹介。EV/PHV急速充電器、行政視察対象案件、電気メーカー直受注、全国チェーンの設備メンテナンスまで。ディレクションとメンテナンスの二軸で積み上げた代表的なケース。"
  breadcrumbs={[{ name: "ホーム", href: "/" }, { name: "事例紹介", href: "/works" }]}
>
  <PageHero
    eyebrow="WORKS"
    title="事例紹介"
    lead="上流と現場のあいだに立つディレクションと、資材に頼らず全国で動くメンテナンス。二軸で積み上げてきた代表的なケースをご紹介します。"
    bg="/img/scaffold-1920.webp"
  />

  <WorksShowcase variant="grid" />

  <!-- 実績サマリ（slim stats） -->
  <section class="bg-ink-50 py-14 md:py-16 border-y border-ink-100">
    <div class="wrap-content">
      <dl class="grid grid-cols-3 gap-0">
        {stats.map((s, i) => (
          <div class:list={["px-1 md:px-4", i !== 0 && "border-l border-ink-200"]}>
            <dt class="text-[10px] tracking-[0.28em] text-warm-700 font-bold uppercase">{s.label}</dt>
            <dd class="mt-3 num-display text-3xl md:text-4xl lg:text-5xl text-ink-900">{s.num}<span class="text-sm text-ink-500 ml-1">{s.unit}</span></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-ink-900 text-white py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 items-end pb-5 border-b-2 border-white">
        <div class="col-span-12 md:col-span-8">
          <p class="swiss-eyebrow text-warm-300">Next</p>
          <h2 class="mt-5 font-serif font-black text-xl md:text-2xl lg:text-3xl leading-[1.25] tracking-[-0.025em]">貴社の案件も、事例にしませんか。</h2>
        </div>
      </div>
      <div class="mt-12 flex flex-wrap gap-3">
        <a href="/contact?topic=reserve" class="btn-warm">相談を予約する <span aria-hidden="true">→</span></a>
        <a href="/contact?topic=docs" class="btn-ghost text-white">資料請求する</a>
      </div>
    </div>
  </section>
</BaseLayout>
