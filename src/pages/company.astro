---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const profile = [
  { k: "商号",       v: site.name },
  { k: "代表者",     v: site.legal.representative },
  { k: "設立",       v: site.legal.established },
  { k: "法人番号",   v: site.legal.corporateNumber },
  { k: "本社所在地", v: site.contact.address.hq },
  { k: "東京営業所", v: site.contact.address.tokyo },
  { k: "電話",       v: site.contact.phone },
  { k: "事業内容",   v: site.business.join("／") },
  { k: "建設業許可", v: site.legal.license },
  { k: "産廃許可",   v: site.legal.industrialWasteLicense },
];
---
<BaseLayout
  title="会社概要"
  description="株式会社モモヤシステムの会社概要。代表・百々彰彦／2007年12月設立／大阪府大阪市生野区／電気工事のディレクション・管理・調整事業。"
  breadcrumbs={[{ name: "ホーム", href: "/" }, { name: "会社概要", href: "/company" }]}
>
  <PageHero
    eyebrow="COMPANY"
    title="会社概要"
    lead={`2007年創業以来、電気工事の現場で20年の実績を積み上げました。<br />20期目（2026年〜）に経営方針を「施工」から「管理・ディレクション」へと転換し、建設電気工事業界の構造的課題を解く事業へ向かいます。`}
    bg="/img/site/photo-01.webp"
  />

  <!-- 代表からのスタンス（編集者的レター） -->
  <section class="bg-white py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10 items-start">
        <div class="col-span-12 md:col-span-4">
          <p class="swiss-eyebrow text-warm-700">Letter / 代表のスタンス</p>
          <h2 class="mt-5 font-serif font-black text-lg md:text-xl lg:text-2xl leading-[1.15] tracking-[-0.02em] text-ink-900 md:max-w-[18ch]">
            「あいだ」の翻訳工数を、見積に書き込む。
          </h2>
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-6">
          <div class="border-t-2 border-ink-900 pt-8 font-serif text-base md:text-lg leading-[1.95] text-ink-900 space-y-5 max-w-[44ch]">
            <p>
              この20年で、電気工事は「ものづくり」から「ものごとづくり」に変わりました。
            </p>
            <p>
              図面と現場、上流と下流、設計と施工 — その<strong class="text-warm-700">「あいだ」の翻訳工数</strong>は、誰の見積にも入っていません。
              だから誰かがそれを引き受け、しかも報われないという構造が、業界の慢性的なロスを生んでいます。
            </p>
            <p>
              私たちはこの空白を、20年の現場経験と50社の協力会社網で埋めます。
              施工は他社に、管理は私たちに。<br />
              そして翻訳工数を、契約に明示します。
            </p>
          </div>
          <p class="mt-8 num text-xs tracking-[0.25em] text-warm-700 font-bold">— 株式会社モモヤシステム 代表取締役　{site.legal.representative}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Greeting / 代表挨拶（フル版） ============ -->
  <section class="bg-ink-50 py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 items-end pb-5 border-b-2 border-ink-900">
        <div class="col-span-12 md:col-span-7">
          <p class="swiss-eyebrow text-ink-700">Greeting / 代表挨拶</p>
          <h2 class="mt-5 font-serif font-black text-xl md:text-2xl lg:text-3xl leading-[1.25] tracking-[-0.025em] md:max-w-[22ch]">
            「高かろう良かろう」から、<br />
            <span class="text-warm-500">「翻訳のプロ」</span>へ。
          </h2>
        </div>
        <p class="col-span-12 md:col-span-4 md:col-start-9 text-sm md:text-base text-ink-700 leading-[1.85] max-w-[34ch]">
          20年の現場経験を持つ実務者が、なぜ「ディレクション会社」を選んだのか。
        </p>
      </div>

      <div class="mt-14 grid grid-cols-12 gap-x-6 gap-y-8">
        <!-- 左: メタ -->
        <div class="col-span-12 md:col-span-3">
          <p class="num text-[10px] tracking-[0.28em] text-warm-700 font-bold">From the founder</p>
          <p class="mt-5 num-display text-warm-500 text-3xl md:text-4xl leading-none">2026 — 20th</p>
          <p class="mt-3 font-serif text-base text-ink-700">代表取締役<br /><strong class="text-ink-900">{site.legal.representative}</strong></p>
        </div>

        <!-- 右: 本文 -->
        <div class="col-span-12 md:col-span-8 md:col-start-5 font-serif text-base md:text-lg leading-[2.0] text-ink-900 space-y-6 max-w-[44ch]">
          <p>
            この20年で、電気工事は「ものづくり」から<strong class="text-warm-700">「ものごとづくり」</strong>に変わりました。
            図面と現場、上流と下流、設計と施工 — その「あいだ」の翻訳工数は、誰の見積にも入っていません。
          </p>
          <p>
            私たちはずっと、現場に強い「工事屋」として生きてきました。施工単価は高かったかもしれませんが、
            「全部任せられる」価値を引き受けてきた自負はあります。<br />
            ところが、その<strong>「高かろう良かろう」を社員に継承することができなかった</strong>。
            やがて「高かろう悪かろう」へ近づき、案件は減り、行き詰まりを感じました。
          </p>
          <p>
            ふと自分の手で現場に戻ってみて、はっきり見えたものがあります。
            <strong class="text-warm-700">業界に足りていないのは、施工者ではなく翻訳者だ</strong>。
            電気の言葉を経営の言葉に変え、設計の意図を施工の段取りに変え、現場の困りごとを上流の意思決定に変える ―
            その「あいだ」を埋める職能こそ、20年磨いてきたものの本質でした。
          </p>
          <p>
            20期目を機に、施工会社から<strong>テクニカル・ディレクション会社</strong>へ完全に切り替えます。
            施工は協力会社に。図面・打合せ・工程・原価は、私たちが翻訳・調整する。
            支払サイトと翻訳工数を、契約に明示する ― それが私たちの最初のルールです。
          </p>
          <p>
            10年で全国、30年で世界中。<br />
            「あいだに立つ会社」が業界の標準になる未来を、ここから20年かけてつくります。
          </p>

          <p class="pt-4 num text-xs tracking-[0.25em] text-warm-700 font-bold">— 株式会社モモヤシステム 代表取締役　{site.legal.representative}</p>
        </div>
      </div>

      <p class="mt-12 text-xs text-ink-500 italic">※ 文章は社内レビュー前のドラフトです。正式版は確定次第差し替えます。</p>
    </div>
  </section>

  <!-- ============ History / 沿革 ============ -->
  <section class="bg-white py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 items-end pb-5 border-b-2 border-ink-900">
        <div class="col-span-12 md:col-span-7">
          <p class="swiss-eyebrow text-ink-700">History / 沿革</p>
          <h2 class="mt-5 font-serif font-black text-xl md:text-2xl lg:text-3xl leading-[1.25] tracking-[-0.025em]">
            創業から、20期目へ。
          </h2>
        </div>
        <p class="col-span-12 md:col-span-4 md:col-start-9 text-sm text-ink-500 leading-relaxed max-w-[34ch]">
          年号・実績は確定値ではなく、公開情報・打合せ記録から推定しています。社長レビューにより最終確定。
        </p>
      </div>

      <ol class="mt-14 max-w-3xl">
        {[
          { year: "2007", body: "創業。電気工事業として大阪府生野区にて事業を開始。" },
          { year: "2010", body: "電気工事業 大阪府知事許可を取得。" },
          { year: "2018", body: "産業廃棄物収集運搬業 許可（第02700196866号）取得。" },
          { year: "2020", body: "EV／PHV 急速充電器インフラ案件の受託を本格開始。" },
          { year: "2023", body: "東京営業所を開設。二拠点体制での全国対応を本格化。" },
          { year: "2024", body: "都知事による視察対象案件（東京・電気付帯）を完工。" },
          { year: "2025", body: "経済産業省「事業継続力強化計画」認定。" },
          { year: "2026", body: "20期目を迎え、経営方針を「施工」から「管理・ディレクション」へ転換。",
            highlight: true },
        ].map((entry, i, arr) => (
          <li class:list={["relative grid grid-cols-12 gap-x-6 gap-y-2 pl-6 pb-10 border-l-2", entry.highlight ? "border-warm-500" : "border-ink-200"]}>
            <span class:list={["absolute -left-[7px] top-1 w-3 h-3", entry.highlight ? "bg-warm-500" : "bg-ink-300"]} aria-hidden="true"></span>
            <div class="col-span-12 md:col-span-3">
              <p class:list={["num-display text-3xl md:text-4xl leading-none", entry.highlight ? "text-warm-500" : "text-ink-900"]}>{entry.year}</p>
            </div>
            <div class="col-span-12 md:col-span-9">
              <p class:list={["text-base leading-[1.85] max-w-[40ch]", entry.highlight ? "text-ink-900 font-bold" : "text-ink-700"]}>{entry.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-4 text-xs text-ink-500 italic">※ 年号は推定値含む。確定値への置き換えを社長レビュー時に実施予定。</p>
    </div>
  </section>

  <Section eyebrow="PROFILE" title="基本情報">
    <dl class="divide-y divide-ink-100 border-y border-ink-100">
      {profile.map((row) => (
        <div class="grid md:grid-cols-[200px_1fr] gap-2 py-5">
          <dt class="text-sm tracking-[0.1em] text-brand-700 font-bold">{row.k}</dt>
          <dd class="text-sm md:text-base text-ink-700 leading-relaxed">{row.v}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section tone="tint" eyebrow="MISSION" title="20期スローガン">
    <blockquote class="border-l-4 border-accent-500 pl-6">
      <p class="font-serif text-lg md:text-xl lg:text-2xl font-bold text-ink-900 leading-relaxed">
        「仕事の喜びを見つける。<br />自信の持てる仕事をし、高評価を得る。」
      </p>
      <footer class="mt-4 text-sm text-ink-500">— 株式会社モモヤシステム 20期スローガン</footer>
    </blockquote>
  </Section>

  <Section eyebrow="VISION" title="100年後を見据えた、段階的な成長像。">
    <ol class="space-y-6">
      {[
        ["10年後", "顧客を全国に持ち、様々なシステムを提供している"],
        ["30年後", "顧客を全世界に持ち、様々なシステムを提供している"],
        ["50年後", "日本の枠をこえて主要国で自社の仕組みで社会に貢献している"],
        ["100年後", "日本の枠をこえて世界中で自社の仕組みで社会に貢献している"],
      ].map(([t, d]) => (
        <li class="grid md:grid-cols-[140px_1fr] gap-4 items-baseline">
          <span class="num text-2xl font-bold text-brand-500">{t}</span>
          <p class="text-ink-700 leading-relaxed">{d}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- ============ SDGs / 業界課題解決と社会貢献 ============ -->
  <section class="bg-warm-50 py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 items-end pb-5 border-b-2 border-warm-700">
        <div class="col-span-12 md:col-span-7">
          <p class="swiss-eyebrow text-warm-700">Sustainability / 業界課題解決と社会貢献</p>
          <h2 class="mt-5 font-serif font-black text-xl md:text-2xl lg:text-3xl leading-[1.25] tracking-[-0.025em] text-warm-900 md:max-w-[20ch]">
            事業そのものが、<br />社会課題への応答。
          </h2>
        </div>
        <p class="col-span-12 md:col-span-4 md:col-start-9 text-sm md:text-base text-ink-700 leading-[1.85] max-w-[34ch]">
          SDGs を別建てのCSRではなく、事業の射程として捉えています。
          関連するゴールを、いま取り組んでいる施策とともに開示します。
        </p>
      </div>

      <ol class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-8">
        {[
          {
            num: "07",
            label: "エネルギーをみんなに",
            sub:   "Affordable and Clean Energy",
            body:  "EV／PHV 急速充電器インフラの設計・施工・申請を全国展開。クリーンエネルギーの社会実装を、電気工事のディレクションから支えます。",
          },
          {
            num: "09",
            label: "産業と技術革新の基盤",
            sub:   "Industry, Innovation and Infrastructure",
            body:  "「電気工事のディレクション」という業界に存在しなかった職能を、20年の現場経験から立ち上げています。中間翻訳の標準化が、産業の生産性を底上げします。",
          },
          {
            num: "11",
            label: "住み続けられるまちづくり",
            sub:   "Sustainable Cities and Communities",
            body:  "公共・行政視察対象の案件を含め、都市インフラの電気工事を担います。工期遵守・品質維持で、住み続けられる街づくりの底力を担保します。",
          },
          {
            num: "12",
            label: "つくる責任 つかう責任",
            sub:   "Responsible Consumption and Production",
            body:  "産業廃棄物収集運搬業許可（第02700196866号）の適正運用。メーカー直 VE ソーシングで、過剰な材料調達と廃棄を抑制します。",
          },
        ].map((g) => (
          <li class="bg-white border-t-2 border-warm-700 p-6 md:p-7">
            <div class="flex items-baseline justify-between">
              <p class="num-display text-warm-500 text-4xl md:text-5xl leading-none">{g.num}</p>
              <p class="text-[10px] tracking-[0.25em] text-warm-700 font-bold uppercase">SDG</p>
            </div>
            <p class="mt-5 font-serif text-lg md:text-xl font-bold text-ink-900 leading-snug">{g.label}</p>
            <p class="mt-1 text-[10px] tracking-[0.2em] text-ink-500 font-bold uppercase">{g.sub}</p>
            <p class="mt-4 text-sm text-ink-700 leading-[1.85] max-w-[36ch]">{g.body}</p>
          </li>
        ))}
      </ol>

      <!-- SDGs 17ゴール公式一覧（社会貢献の枠を示す視覚素材） -->
      <figure class="mt-16 bg-white p-6 md:p-10 border border-warm-100">
        <img src="/img/sdgs-17goals-1200.webp" alt="持続可能な開発目標（SDGs）の17ゴール" loading="lazy" decoding="async" class="block w-full max-w-3xl mx-auto" />
        <figcaption class="mt-4 text-xs text-ink-500 text-center">国連が定めた持続可能な開発目標（SDGs）の17ゴールから、私たちが事業として応答できる4つを選び、上記の章で開示しました。</figcaption>
      </figure>

      <p class="mt-12 text-xs text-ink-500 italic max-w-[60ch]">※ 取り組みの定量実績（CO2削減量等）は、確定次第本ページに掲載します。</p>
    </div>
  </section>

  <Section tone="dark" eyebrow="GROUP" title="モモヤホールディングス（構想）">
    <p class="max-w-[60ch] text-ink-100 leading-[1.85]">
      電気工事の管理・ディレクションを担うモモヤシステムを中核に、
      電気以外の工事事業（イフス）、業界課題解決の支援事業（モモヤコネクト）、
      防災支援（一般社団法人 日本防災支援機構）と連携し、
      「業界課題解決型のトータルソリューション提供会社」を目指します。
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/group" class="btn-warm">
        グループ構成と連携の射程を見る <span aria-hidden="true">→</span>
      </a>
    </div>
  </Section>
</BaseLayout>
