---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const profile = [
  { k: "商号",       v: site.name },
  { k: "代表者",     v: site.legal.representative },
  { k: "設立",       v: site.legal.established },
  { k: "法人番号",   v: site.legal.corporateNumber },
  { k: "本社所在地", v: site.contact.address.hq },
  { k: "東京営業所", v: site.contact.address.tokyo },
  { k: "電話",       v: site.contact.phone },
  { k: "事業内容",   v: site.business.join("／") },
  { k: "建設業許可", v: site.legal.license },
  { k: "産廃許可",   v: site.legal.industrialWasteLicense },
];
---
<BaseLayout
  title="会社概要"
  description="株式会社モモヤシステムの会社概要。代表・百々彰彦／2007年12月設立／大阪府大阪市生野区／電気工事のディレクション・管理・調整事業。"
  breadcrumbs={[{ name: "ホーム", href: "/" }, { name: "会社概要", href: "/company" }]}
>
  <PageHero
    eyebrow="COMPANY"
    title="会社概要"
    lead={`2007年創業以来、電気工事の現場で20年の実績を積み上げました。<br />20期目（2026年〜）に経営方針を「施工」から「管理・ディレクション」へと転換し、建設電気工事業界の構造的課題を解く事業へ向かいます。`}
    bg="/img/cityscape-1280.jpg"
  />

  <!-- 代表からのスタンス（編集者的レター） -->
  <section class="bg-white py-24 md:py-32">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10 items-start">
        <div class="col-span-12 md:col-span-4">
          <p class="swiss-eyebrow text-warm-700">Letter / 代表のスタンス</p>
          <h2 class="mt-5 font-serif font-black text-2xl md:text-4xl leading-[1.15] tracking-[-0.02em] text-ink-900 max-w-[18ch]">
            「あいだ」の翻訳工数を、見積に書き込む。
          </h2>
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-6">
          <div class="border-t-2 border-ink-900 pt-8 font-serif text-base md:text-lg leading-[1.95] text-ink-900 space-y-5 max-w-[44ch]">
            <p>
              この20年で、電気工事は「ものづくり」から「ものごとづくり」に変わりました。
            </p>
            <p>
              図面と現場、上流と下流、設計と施工 — その<strong class="text-warm-700">「あいだ」の翻訳工数</strong>は、誰の見積にも入っていません。
              だから誰かがそれを引き受け、しかも報われないという構造が、業界の慢性的なロスを生んでいます。
            </p>
            <p>
              私たちはこの空白を、20年の現場経験と50社の協力会社網で埋めます。
              施工は他社に、管理は私たちに。<br />
              そして翻訳工数を、契約に明示します。
            </p>
          </div>
          <p class="mt-8 num text-xs tracking-[0.25em] text-warm-700 font-bold">— 株式会社モモヤシステム 代表取締役　{site.legal.representative}</p>
        </div>
      </div>
    </div>
  </section>

  <Section eyebrow="PROFILE" title="基本情報">
    <dl class="divide-y divide-ink-100 border-y border-ink-100">
      {profile.map((row) => (
        <div class="grid md:grid-cols-[200px_1fr] gap-2 py-5">
          <dt class="text-sm tracking-[0.1em] text-brand-700 font-bold">{row.k}</dt>
          <dd class="text-sm md:text-base text-ink-700 leading-relaxed">{row.v}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section tone="tint" eyebrow="MISSION" title="20期スローガン">
    <blockquote class="border-l-4 border-accent-500 pl-6">
      <p class="font-serif text-2xl md:text-3xl font-bold text-ink-900 leading-relaxed">
        「仕事の喜びを見つける。<br />自信の持てる仕事をし、高評価を得る。」
      </p>
      <footer class="mt-4 text-sm text-ink-500">— 株式会社モモヤシステム 20期スローガン</footer>
    </blockquote>
  </Section>

  <Section eyebrow="VISION" title="100年後を見据えた、段階的な成長像。">
    <ol class="space-y-6">
      {[
        ["10年後", "顧客を全国に持ち、様々なシステムを提供している"],
        ["30年後", "顧客を全世界に持ち、様々なシステムを提供している"],
        ["50年後", "日本の枠をこえて主要国で自社の仕組みで社会に貢献している"],
        ["100年後", "日本の枠をこえて世界中で自社の仕組みで社会に貢献している"],
      ].map(([t, d]) => (
        <li class="grid md:grid-cols-[140px_1fr] gap-4 items-baseline">
          <span class="num text-2xl font-bold text-brand-500">{t}</span>
          <p class="text-ink-700 leading-relaxed">{d}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section tone="dark" eyebrow="GROUP" title="モモヤホールディングス（構想）">
    <p class="max-w-[60ch] text-ink-100 leading-relaxed">
      電気工事の管理・ディレクションを担うモモヤシステムを中核に、
      電気以外の工事事業（イフス）、業界課題解決の支援事業（モモヤコネクト）、
      防災支援（一般社団法人 日本防災支援機構）と連携し、
      「業界課題解決型のトータルソリューション提供会社」を目指します。
    </p>
  </Section>
</BaseLayout>
