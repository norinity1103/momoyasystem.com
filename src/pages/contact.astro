---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

// 既定: Cloudflare Pages Functions の自前バックエンド (/api/contact)
// 環境変数 PUBLIC_FORM_ENDPOINT で Formspree など外部サービスにも切替可能。
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || "/api/contact";
---
<BaseLayout
  title="お問い合わせ"
  description="モモヤシステムへのお問い合わせ。電気工事のディレクション・図面・打ち合わせ代行・パートナー選定など、案件の段階を問わずご相談を承ります。東京・大阪二拠点で全国対応。"
  breadcrumbs={[{ name: "ホーム", href: "/" }, { name: "お問い合わせ", href: "/contact" }]}
>
  <PageHero
    eyebrow="CONTACT"
    title="まずは、ご相談ください。"
    lead={`見積依頼の段階からでも構いません。<br />案件の規模・進捗・地域をお伝えください。最短で当日中にご返信します。`}
  />

  <section class="py-24">
    <div class="container-x grid lg:grid-cols-5 gap-12">
      <div class="lg:col-span-3">
        <h2 class="font-serif text-2xl font-bold">お問い合わせフォーム</h2>
        <form
          name="contact"
          method="POST"
          action={formEndpoint}
          class="mt-8 space-y-6"
        >
          <p class="hidden" aria-hidden="true"><label>Leave this field empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>
          <input type="hidden" name="_subject" value="モモヤシステム HP からのお問い合わせ" />
          <input type="hidden" name="_format" value="plain" />

          <div>
            <label class="text-xs tracking-[0.2em] text-ink-500" for="company">会社名 <span class="text-accent-500">*</span></label>
            <input id="company" name="company" required class="mt-2 w-full border border-ink-300 px-4 py-3 focus:border-brand-500 focus:outline-none" />
          </div>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="text-xs tracking-[0.2em] text-ink-500" for="name">ご担当者名 <span class="text-accent-500">*</span></label>
              <input id="name" name="name" required class="mt-2 w-full border border-ink-300 px-4 py-3 focus:border-brand-500 focus:outline-none" />
            </div>
            <div>
              <label class="text-xs tracking-[0.2em] text-ink-500" for="email">メールアドレス <span class="text-accent-500">*</span></label>
              <input id="email" name="email" type="email" required class="mt-2 w-full border border-ink-300 px-4 py-3 focus:border-brand-500 focus:outline-none" />
            </div>
          </div>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="text-xs tracking-[0.2em] text-ink-500" for="phone">電話番号</label>
              <input id="phone" name="phone" class="mt-2 w-full border border-ink-300 px-4 py-3 focus:border-brand-500 focus:outline-none" />
            </div>
            <div>
              <label class="text-xs tracking-[0.2em] text-ink-500" for="region">対応地域</label>
              <select id="region" name="region" class="mt-2 w-full border border-ink-300 px-4 py-3 focus:border-brand-500 focus:outline-none bg-white">
                <option>関東（東京中心）</option>
                <option>関西（大阪中心）</option>
                <option>その他全国</option>
                <option>未定</option>
              </select>
            </div>
          </div>
          <div>
            <label class="text-xs tracking-[0.2em] text-ink-500" for="topic">ご相談内容</label>
            <select id="topic" name="topic" class="mt-2 w-full border border-ink-300 px-4 py-3 focus:border-brand-500 focus:outline-none bg-white">
              <option>電気工事のディレクション・管理委託</option>
              <option>業者選定・パートナー紹介</option>
              <option>図面・施工図の作成・チェック</option>
              <option>材料調達のみ</option>
              <option>急速充電器（EV/PHV）案件</option>
              <option>その他</option>
            </select>
          </div>
          <div>
            <label class="text-xs tracking-[0.2em] text-ink-500" for="message">案件の概要・ご要望 <span class="text-accent-500">*</span></label>
            <textarea id="message" name="message" rows="6" required class="mt-2 w-full border border-ink-300 px-4 py-3 focus:border-brand-500 focus:outline-none"></textarea>
          </div>
          <button type="submit" class="inline-flex items-center gap-2 px-7 py-4 bg-brand-700 text-white font-bold rounded-sm hover:bg-brand-500 transition">
            送信する <span aria-hidden="true">→</span>
          </button>
          <p class="text-xs text-ink-500">送信いただいた内容は、ご返信およびサービス提供以外には利用しません。</p>
        </form>
      </div>

      <aside class="lg:col-span-2 space-y-8">
        <div class="p-6 bg-ink-50 border-l-4 border-brand-500">
          <p class="text-xs tracking-[0.2em] text-brand-500">DIRECT</p>
          <p class="mt-3 text-sm text-ink-700">電話・メールでのお問い合わせも歓迎です。</p>
          <p class="mt-2 num text-lg font-bold">{site.contact.phone}</p>
          <p class="num text-sm"><a class="underline" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        </div>
        <div>
          <p class="text-xs tracking-[0.2em] text-brand-500">OFFICE</p>
          <dl class="mt-3 space-y-4 text-sm">
            <div><dt class="font-bold">大阪本社</dt><dd class="text-ink-700">{site.contact.address.hq}</dd></div>
            <div><dt class="font-bold">東京営業所</dt><dd class="text-ink-700">{site.contact.address.tokyo}</dd></div>
          </dl>
        </div>
        <div class="p-6 border border-ink-100">
          <p class="text-xs tracking-[0.2em] text-brand-500">LICENSE</p>
          <p class="mt-3 text-sm text-ink-700">{site.legal.license}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
