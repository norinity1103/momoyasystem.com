---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import LossSavingsInfographic from "../components/LossSavingsInfographic.astro";
---
<BaseLayout
  title="介在価値"
  description="管理不在の現場で失われる利益と、モモヤシステム介在による利益保全のロジックを、1億円規模の電気工事案件モデルで図解。商談で1時間説明する内容を、3分で。"
>
  <section class="bg-brand-900 text-white py-24 md:py-32">
    <div class="container-x">
      <p class="text-xs tracking-[0.3em] text-brand-300">VALUE</p>
      <h1 class="mt-4 font-serif text-4xl md:text-6xl font-black leading-tight">
        数字で見る、<br />介在価値。
      </h1>
      <p class="mt-8 max-w-3xl text-base md:text-lg text-ink-100 leading-relaxed">
        「翻訳料」と聞くと中抜きに見えるかもしれません。<br />
        しかし、管理不在で失われる損失と、介在による費用を比較すれば、答えは明らかです。
      </p>
    </div>
  </section>

  <Section eyebrow="COMPARISON" title="管理不在 ／ モモヤ介在 の比較">
    <LossSavingsInfographic />
  </Section>

  <Section tone="tint" eyebrow="HOW" title="モモヤが担う、4つの管理。">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { n: "01", t: "打ち合わせ管理", d: "上流と下流のあいだに立ち、専門用語を翻訳。レスを速くし、図面と仕様を一発で確定。" },
        { n: "02", t: "図面管理", d: "施工図のチェック・修正・展開。CAD作成にも対応し、設計段階から関与可能。" },
        { n: "03", t: "工程管理", d: "週休2日制・労働時間規制を踏まえた現実的な工程設計とウォッチ。遅延を未然に防止。" },
        { n: "04", t: "材料・原価管理", d: "メーカー直取引で材料を一括調達。スケールメリットを管理費の原資に充当。" },
      ].map((c) => (
        <div class="p-6 bg-white border border-ink-100">
          <p class="num text-xs text-brand-500">{c.n}</p>
          <h3 class="mt-2 font-serif text-lg font-bold">{c.t}</h3>
          <p class="mt-3 text-sm text-ink-700 leading-relaxed">{c.d}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="dark" eyebrow="NEXT" title="商談用の資料が必要ですか？">
    <p class="text-ink-100 max-w-2xl leading-relaxed">
      この図解の印刷用PDF（A3一枚）と会社案内をご用意しています。<br />
      お気軽にお問い合わせください。
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/contact" class="inline-flex items-center gap-2 px-7 py-4 bg-white text-brand-900 font-bold rounded-sm hover:bg-brand-50 transition">
        資料請求・お問い合わせ <span aria-hidden="true">→</span>
      </a>
    </div>
  </Section>
</BaseLayout>
