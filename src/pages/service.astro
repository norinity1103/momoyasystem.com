---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import PageHero from "../components/PageHero.astro";

// ── 二軸ハブ：テクニカルディレクション（軸A）／ メンテナンス（軸B） ──
const axes = [
  {
    key: "A",
    href: "/service/direction",
    en: "TECHNICAL DIRECTION",
    title: "テクニカルディレクション",
    lead: "元請と施工現場の「あいだ」に立ち、電気の全体最適を設計する。定例代行・施工図監修・工程設計・材料ソーシングで、打ち合わせ・図面・お金・工程の“流れ”を管理します。",
    points: ["定例代行・VE提案", "施工図監修・申請対応", "工程・週休2日プランニング", "メーカー直材料調達"],
    metric: { num: "▲ 5–15", unit: "%", label: "手戻り損失の抑制レンジ" },
  },
  {
    key: "B",
    href: "/service/maintenance",
    en: "MAINTENANCE",
    title: "メンテナンス",
    lead: "材料に頼らず、全国で動く。漏電・絶縁調査、設備診断、老朽化調査から高圧機器の交換、店舗設備の保守まで。調査から報告書・是正提案までを一つの窓口で完結させます。",
    points: ["漏電・絶縁調査", "設備診断・老朽化調査", "高圧機器の交換・更新", "照明・看板・サイネージ保守"],
    metric: { num: "2", unit: "拠点", label: "大阪・東京で全国対応" },
  },
];
---
<BaseLayout
  title="事業内容"
  description="モモヤシステムの事業は二軸。元請と現場の「あいだ」に立つテクニカルディレクションと、材料に頼らず全国で動くメンテナンス。電気工事と付帯領域を、ひとつの窓口で束ねます。"
  breadcrumbs={[{ name: "ホーム", href: "/" }, { name: "事業内容", href: "/service" }]}
>
  <PageHero
    eyebrow="SERVICE / 事業内容"
    title="二つの軸で、電気の現場を支える。"
    lead="上流と現場の「あいだ」に立つテクニカルディレクション（軸A）と、資材に左右されず全国で動くメンテナンス（軸B）。この二軸が、モモヤシステムの現在の形です。"
  />

  <!-- ============ 二軸カード ============ -->
  <section class="bg-white py-20 md:py-28">
    <div class="wrap-content grid md:grid-cols-2 gap-6 lg:gap-8 observe-stagger">
      {axes.map((a) => (
        <a href={a.href} class="group relative flex flex-col bg-white border border-ink-100 hover:border-brand-500 transition-colors rounded-sm p-8 md:p-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-500">
          <span class="block w-12 h-[3px] bg-warm-500"></span>
          <p class="mt-6 text-[10px] tracking-[0.3em] text-ink-500 font-bold">軸{a.key} ／ {a.en}</p>
          <h2 class="mt-3 font-serif text-xl md:text-2xl font-black text-ink-900 tracking-tight">{a.title}</h2>
          <p class="mt-5 text-sm md:text-base text-ink-700 leading-[1.85] max-w-[42ch]">{a.lead}</p>
          <ul class="mt-7 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5">
            {a.points.map((p) => (
              <li class="flex gap-2.5 text-sm text-ink-700 leading-relaxed">
                <span class="text-warm-500 mt-1.5 flex-shrink-0 w-1.5 h-1.5 rounded-full bg-warm-500 inline-block"></span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 pt-8 flex items-end justify-between gap-4 border-t-2 border-ink-900">
            <span class="num-display text-2xl md:text-3xl text-ink-900">{a.metric.num}<span class="text-sm text-ink-500 ml-1">{a.metric.unit}</span>
              <span class="block text-[10px] tracking-[0.2em] text-ink-500 uppercase font-bold mt-1">{a.metric.label}</span>
            </span>
            <span class="text-sm font-bold text-brand-700 group-hover:text-warm-600 transition-colors whitespace-nowrap">詳しく見る <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ Coverage / 対応領域 ============ -->
  <section class="bg-white py-24 md:py-32 border-t border-ink-100">
    <div class="wrap-content">
      <div class="grid grid-cols-12 gap-x-6 items-end pb-5 border-b-2 border-ink-900">
        <div class="col-span-12 md:col-span-7">
          <p class="swiss-eyebrow text-ink-700">Coverage / 対応領域</p>
          <h2 class="mt-5 font-serif font-black text-xl md:text-2xl lg:text-3xl leading-[1.25] tracking-[-0.02em] md:max-w-[20ch]">
            電気工事と<span class="text-warm-500">付帯領域</span>を、<br />
            ひとつの窓口で。
          </h2>
        </div>
        <p class="col-span-12 md:col-span-4 md:col-start-9 text-sm md:text-base text-ink-700 leading-[1.85] max-w-[34ch]">
          受電・分電・配線から、内装・空調・土工までをパートナー50社+のチーム編成でカバー。元請の発注先を、私たちで束ねます。
        </p>
      </div>

      <!-- 電気工事 -->
      <div class="mt-16">
        <div class="flex items-baseline gap-4">
          <p class="num text-[10px] tracking-[0.28em] text-warm-700 font-bold">N°01</p>
          <h3 class="font-serif text-xl md:text-2xl font-bold text-ink-900 tracking-tight">電気工事</h3>
        </div>
        <dl class="mt-6 border-t-2 border-ink-900">
          {[
            { k: "強電",   v: "受変電設備 ／ 動力設備 ／ 幹線設備 ／ 分電盤・制御盤" },
            { k: "弱電",   v: "LAN・電話・放送 ／ 防犯カメラ ／ 入退室管理 ／ 火災報知" },
            { k: "高圧",   v: "キュービクル ／ 高圧引込 ／ 自家用電気工作物の保安" },
            { k: "特殊",   v: "EV／PHV 急速充電器 ／ 太陽光・蓄電池 連系 ／ 非常用発電" },
          ].map((row) => (
            <div class="spec-row">
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- 付帯工事 -->
      <div class="mt-16">
        <div class="flex items-baseline gap-4">
          <p class="num text-[10px] tracking-[0.28em] text-warm-700 font-bold">N°02</p>
          <h3 class="font-serif text-xl md:text-2xl font-bold text-ink-900 tracking-tight">付帯工事</h3>
        </div>
        <dl class="mt-6 border-t-2 border-ink-900">
          {[
            { k: "内装",   v: "軽天・ボード ／ クロス ／ 床仕上げ ／ 間仕切" },
            { k: "空調",   v: "業務用エアコン ／ 換気・排煙 ／ ダクト" },
            { k: "土工",   v: "充電器基礎 ／ 配管引込 ／ 舗装復旧" },
            { k: "メンテ", v: "店舗・住宅の電気・空調・弱電 ／ 緊急対応" },
          ].map((row) => (
            <div class="spec-row">
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <p class="mt-12 text-xs text-ink-500 max-w-[60ch] italic">※ 自社施工は最小限。50社+のパートナーから案件専任チームを編成します。記載のない領域もお気軽にご相談ください。</p>
    </div>
  </section>

  <Section tone="dark" eyebrow="NEXT" title="どちらの軸から話しますか？">
    <p class="text-ink-100 max-w-[60ch] leading-[1.85]">
      案件のディレクション相談も、設備の調査依頼も、まずはお気軽にお問い合わせください。関与範囲とお見積りの考え方をご提案します。
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/service/direction" class="btn-warm">軸A：テクニカルディレクション <span aria-hidden="true">→</span></a>
      <a href="/service/maintenance" class="btn-warm">軸B：メンテナンス <span aria-hidden="true">→</span></a>
      <a href="/contact" class="btn-ghost text-white">お問い合わせ</a>
    </div>
  </Section>
</BaseLayout>
