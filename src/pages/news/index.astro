---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import PageHero from "../../components/PageHero.astro";

const all = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---
<BaseLayout
  title="ニュース"
  description="株式会社モモヤシステムからのお知らせ・リリース・メディア掲載情報。"
  breadcrumbs={[{ name: "ホーム", href: "/" }, { name: "ニュース", href: "/news" }]}
>
  <PageHero
    eyebrow="NEWS"
    title="ニュース"
    lead="モモヤシステムからのお知らせ・リリース・メディア掲載情報を掲載しています。"
  />

  <Section eyebrow="LATEST" title="最新のお知らせ">
    {all.length === 0 ? (
      <p class="text-ink-500">現在、お知らせはありません。</p>
    ) : (
      <ul class="divide-y divide-ink-100 border-y border-ink-100">
        {all.map((entry) => (
          <li>
            <a href={`/news/${entry.id}`} class="grid md:grid-cols-[120px_120px_1fr] gap-4 py-6 group items-baseline">
              <time class="num text-sm text-ink-500" datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
              <span class="text-[10px] tracking-[0.2em] text-brand-700 border border-brand-700 px-2 py-1 inline-block w-fit">{entry.data.category}</span>
              <span class="text-base md:text-lg leading-snug font-bold group-hover:text-brand-500 transition">
                {entry.data.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Section>
</BaseLayout>
